<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_card_bg"
    android:padding="12dp"
    android:gravity="center_horizontal">

    <!-- Realistic Analog/Digital Chronograph Stopwatch Dial -->
    <com.google.ambient.nesthub.views.StopwatchDialView
        android:id="@+id/stopwatchDialView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Exactly Three Options: Start/Stop, Lap, and Reset -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginTop="6dp">

        <!-- 1. Start / Stop -->
        <Button
            android:id="@+id/btnStopwatchStart"
            style="@style/Widget.Material3.Button"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:text="Start"
            android:textSize="12sp"
            android:backgroundTint="@color/nest_primary_container"
            android:textColor="@color/nest_on_primary_container"
            android:padding="0dp" />

        <!-- 2. Lap -->
        <Button
            android:id="@+id/btnStopwatchLap"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="Lap"
            android:textSize="12sp"
            android:padding="0dp" />

        <!-- 3. Reset -->
        <Button
            android:id="@+id/btnStopwatchReset"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="Reset"
            android:textSize="12sp"
            android:padding="0dp" />
    </LinearLayout>

    <!-- Lap Status Text Below -->
    <TextView
        android:id="@+id/stopwatchLapStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Lap 0 • Ready"
        android:textColor="@color/text_secondary"
        android:textSize="11sp"
        android:maxLines="1"
        android:ellipsize="end" />
</LinearLayout>
