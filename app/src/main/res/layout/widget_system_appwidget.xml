<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/systemAppWidgetContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_card_bg"
    android:padding="8dp">

    <!-- AppWidgetHostView will be dynamically inserted here -->
    <LinearLayout
        android:id="@+id/systemAppWidgetEmptyPlaceholder"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:gravity="center"
            android:background="@drawable/button_pill_accent"
            android:backgroundTint="#33FFFFFF"
            android:text="⊞"
            android:textColor="@color/nest_primary"
            android:textSize="22sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Choose Android Home Widget"
            android:textColor="@color/white"
            android:textSize="13sp"
            android:fontFamily="sans-serif-medium" />
    </LinearLayout>
</FrameLayout>
