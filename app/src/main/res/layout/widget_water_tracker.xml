<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_card_bg"
    android:padding="16dp"
    android:gravity="center_vertical">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Hydration Tracker"
        android:textColor="@color/nest_accent_cyan"
        android:textSize="14sp"
        android:fontFamily="sans-serif-medium" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/waterCountText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="5 / 8 Cups"
            android:textColor="@color/white"
            android:textSize="26sp"
            android:fontFamily="sans-serif-bold" />

        <Button
            android:id="@+id/btnWaterMinus"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:padding="0dp"
            android:text="−"
            android:textSize="18sp" />

        <Button
            android:id="@+id/btnWaterPlus"
            style="@style/Widget.Material3.Button"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginStart="8dp"
            android:padding="0dp"
            android:text="+"
            android:textSize="18sp"
            android:backgroundTint="@color/nest_primary_container"
            android:textColor="@color/nest_on_primary_container" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/waterProgressBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="8dp"
        android:layout_marginTop="10dp"
        android:progress="62"
        android:progressTint="@color/nest_accent_cyan" />
</LinearLayout>

