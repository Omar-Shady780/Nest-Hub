<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_card_bg"
    android:padding="16dp"
    android:gravity="center_vertical">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Now Playing"
        android:textColor="@color/nest_accent_coral"
        android:textSize="13sp"
        android:fontFamily="sans-serif-medium" />

    <TextView
        android:id="@+id/mediaTrackTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Weightless (Ambient 1)"
        android:textColor="@color/white"
        android:textSize="17sp"
        android:fontFamily="sans-serif-medium"
        android:maxLines="1"
        android:ellipsize="end" />

    <TextView
        android:id="@+id/mediaArtist"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Marconi Union"
        android:textColor="@color/text_secondary"
        android:textSize="13sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/btnMediaPrev"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/button_pill_accent"
            android:backgroundTint="#33FFFFFF"
            android:src="@drawable/ic_media_prev"
            android:tint="@color/white"
            android:scaleType="centerInside"
            android:contentDescription="Previous Track" />

        <ImageButton
            android:id="@+id/btnMediaPlayPause"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:background="@drawable/button_pill_accent"
            android:backgroundTint="@color/nest_primary"
            android:src="@drawable/ic_media_play"
            android:tint="@color/white"
            android:scaleType="centerInside"
            android:contentDescription="Play/Pause" />

        <ImageButton
            android:id="@+id/btnMediaNext"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/button_pill_accent"
            android:backgroundTint="#33FFFFFF"
            android:src="@drawable/ic_media_next"
            android:tint="@color/white"
            android:scaleType="centerInside"
            android:contentDescription="Next Track" />
    </LinearLayout>
</LinearLayout>

