<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    android:keepScreenOn="true">

    <!-- Dynamic Background Container -->
    <ImageView
        android:id="@+id/bgImageView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:contentDescription="Background" />

    <!-- Subtle Dim Overlay -->
    <View
        android:id="@+id/bgDimOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#26000000" />

    <!-- StandBy OLED Pitch Black Smooth Transition Overlay -->
    <View
        android:id="@+id/standbyBlackOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/black"
        android:alpha="0.0" />

    <!-- Main Content View Flipper (Only 3 Screens: Dashboard, Digital StandBy, Analog StandBy) -->
    <ViewFlipper
        android:id="@+id/mainViewFlipper"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Screen 0: Main Interactive Widgets Dashboard -->
        <FrameLayout
            android:id="@+id/dashboardScreen"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <!-- Top Header Status Bar: ONLY Date, Battery Percentage, and Settings Button -->
            <LinearLayout
                android:id="@+id/topStatusBar"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="24dp"
                android:paddingEnd="24dp">

                <!-- Only Date on the left -->
                <TextView
                    android:id="@+id/headerDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Friday, October 30"
                    android:textColor="@color/white"
                    android:textSize="17sp"
                    android:fontFamily="sans-serif-medium" />

                <!-- Spacer -->
                <View
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <!-- Battery Percentage & Icon -->
                <LinearLayout
                    android:id="@+id/headerBatteryContainer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginEnd="18dp">

                    <ImageView
                        android:id="@+id/headerBatteryIcon"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_battery" />

                    <TextView
                        android:id="@+id/headerBatteryPercent"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:text="100%"
                        android:textColor="@color/white"
                        android:textSize="15sp"
                        android:fontFamily="sans-serif-bold" />
                </LinearLayout>

                <!-- Settings Button -->
                <ImageView
                    android:id="@+id/btnSettings"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:padding="8dp"
                    android:background="@drawable/button_pill_accent"
                    android:src="@drawable/ic_settings"
                    android:contentDescription="Settings" />
            </LinearLayout>

            <!-- Dynamic Grid Layout for Widgets (2x2 or 3x3) -->
            <GridLayout
                android:id="@+id/widgetGridLayout"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="56dp"
                android:layout_marginBottom="8dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:alignmentMode="alignMargins"
                android:useDefaultMargins="true" />
        </FrameLayout>

        <!-- Screen 1: StandBy Fullscreen Digital Clock (Apple StandBy Style) -->
        <FrameLayout
            android:id="@+id/standbyDigitalScreen"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="32dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <!-- Left Side: Digital Clock with Hours, Minutes, Seconds horizontally -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1.2"
                    android:gravity="center"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:id="@+id/standbyDigitalTime"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="10:42"
                            android:textColor="@color/white"
                            android:textSize="96sp"
                            android:fontFamily="sans-serif-black"
                            android:includeFontPadding="false" />

                        <TextView
                            android:id="@+id/standbyDigitalSeconds"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:text=":36"
                            android:textColor="@color/nest_accent_coral"
                            android:textSize="54sp"
                            android:fontFamily="sans-serif-bold"
                            android:includeFontPadding="false" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/standbyDigitalDate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="FRIDAY, OCTOBER 30"
                        android:textColor="@color/nest_primary"
                        android:textSize="22sp"
                        android:fontFamily="sans-serif-medium"
                        android:letterSpacing="0.08" />
                </LinearLayout>

                <!-- Right Side: Alarm & Battery Information -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="0.8"
                    android:orientation="vertical"
                    android:paddingStart="32dp">

                    <!-- Next Alarm Pill -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:background="@drawable/button_pill_accent"
                        android:paddingStart="18dp"
                        android:paddingEnd="18dp"
                        android:paddingTop="10dp"
                        android:paddingBottom="10dp">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:src="@drawable/ic_alarm" />

                        <TextView
                            android:id="@+id/standbyDigitalAlarm"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:text="Alarm: 07:00 AM • Tomorrow"
                            android:textColor="@color/white"
                            android:textSize="16sp"
                            android:fontFamily="sans-serif-medium" />
                    </LinearLayout>

                    <!-- Battery Status Pill -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:background="@drawable/button_pill_accent"
                        android:paddingStart="18dp"
                        android:paddingEnd="18dp"
                        android:paddingTop="10dp"
                        android:paddingBottom="10dp">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:src="@drawable/ic_battery" />

                        <TextView
                            android:id="@+id/standbyDigitalBattery"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:text="Battery: 85% • AC Charging"
                            android:textColor="@color/nest_accent_mint"
                            android:textSize="16sp"
                            android:fontFamily="sans-serif-medium" />
                    </LinearLayout>

                    <!-- Weather Quick Info -->
                    <TextView
                        android:id="@+id/standbyDigitalWeather"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="74°F  •  Mostly Sunny"
                        android:textColor="@color/text_secondary"
                        android:textSize="18sp"
                        android:fontFamily="sans-serif" />
                </LinearLayout>
            </LinearLayout>
        </FrameLayout>

        <!-- Screen 2: StandBy Fullscreen Analog Clock -->
        <FrameLayout
            android:id="@+id/standbyAnalogScreen"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <!-- Analog Dial Left -->
                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1.1">

                    <com.google.ambient.nesthub.views.AnalogClockView
                        android:id="@+id/standbyAnalogClockView"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_gravity="center" />
                </FrameLayout>

                <!-- Information Right: Date, Alarm, Battery Percentage & Charging -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="0.9"
                    android:orientation="vertical"
                    android:paddingStart="24dp">

                    <!-- Date -->
                    <TextView
                        android:id="@+id/standbyAnalogDate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="FRIDAY, OCTOBER 30"
                        android:textColor="@color/nest_primary"
                        android:textSize="22sp"
                        android:fontFamily="sans-serif-medium"
                        android:letterSpacing="0.08" />

                    <!-- Next Alarm -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:background="@drawable/button_pill_accent"
                        android:paddingStart="18dp"
                        android:paddingEnd="18dp"
                        android:paddingTop="10dp"
                        android:paddingBottom="10dp">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:src="@drawable/ic_alarm" />

                        <TextView
                            android:id="@+id/standbyAnalogAlarm"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:text="Alarm: 07:00 AM"
                            android:textColor="@color/white"
                            android:textSize="16sp"
                            android:fontFamily="sans-serif-medium" />
                    </LinearLayout>

                    <!-- Battery % & Charging Status -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:background="@drawable/button_pill_accent"
                        android:paddingStart="18dp"
                        android:paddingEnd="18dp"
                        android:paddingTop="10dp"
                        android:paddingBottom="10dp">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:src="@drawable/ic_battery" />

                        <TextView
                            android:id="@+id/standbyAnalogBattery"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:text="Battery: 85% • AC Charging"
                            android:textColor="@color/nest_accent_mint"
                            android:textSize="16sp"
                            android:fontFamily="sans-serif-medium" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </FrameLayout>
    </ViewFlipper>

    <!-- Bedtime Ultra-Dim & Red Shift Filter Overlay -->
    <View
        android:id="@+id/redFilterOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/night_red_filter"
        android:visibility="gone" />

    <!-- Sleek Top-Center Brightness HUD Overlay (Appears when Volume keys adjust screen brightness) -->
    <LinearLayout
        android:id="@+id/brightnessHudContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="20dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/button_pill_accent"
        android:backgroundTint="#EE1E2129"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:elevation="12dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="☀️"
            android:textSize="18sp"
            android:layout_marginEnd="12dp" />

        <ProgressBar
            android:id="@+id/brightnessHudProgress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="160dp"
            android:layout_height="8dp"
            android:max="100"
            android:progress="60"
            android:progressTint="@color/nest_primary"
            android:progressBackgroundTint="#44FFFFFF" />

        <TextView
            android:id="@+id/brightnessHudText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="60%"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:fontFamily="sans-serif-medium" />
    </LinearLayout>

</FrameLayout>
