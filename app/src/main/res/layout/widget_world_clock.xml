<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_card_bg"
    android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="World Clocks"
        android:textColor="@color/nest_accent_purple"
        android:textSize="14sp"
        android:fontFamily="sans-serif-medium" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="6dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="London (GMT)"
            android:textColor="@color/white"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/worldClockLondon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="18:42"
            android:textColor="@color/nest_primary"
            android:textSize="17sp"
            android:fontFamily="sans-serif-bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Tokyo (JST)"
            android:textColor="@color/white"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/worldClockTokyo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="03:42 (+1)"
            android:textColor="@color/nest_accent_mint"
            android:textSize="17sp"
            android:fontFamily="sans-serif-bold" />
    </LinearLayout>
</LinearLayout>

