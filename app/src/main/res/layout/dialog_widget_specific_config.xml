<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#1E2028"
    android:padding="24dp">

    <!-- Header -->
    <TextView
        android:id="@+id/specificConfigTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Widget Settings"
        android:textColor="@color/white"
        android:textSize="22sp"
        android:fontFamily="sans-serif-bold" />

    <TextView
        android:id="@+id/specificConfigSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Configure options for this widget"
        android:textColor="@color/text_secondary"
        android:textSize="14sp" />

    <!-- Specific options container -->
    <LinearLayout
        android:id="@+id/specificOptionsContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:orientation="vertical" />

    <!-- Accent Color Chooser -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="CARD ACCENT TINT"
        android:textColor="@color/nest_primary"
        android:textSize="12sp"
        android:fontFamily="sans-serif-bold"
        android:letterSpacing="0.08" />

    <LinearLayout
        android:id="@+id/widgetAccentColorRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <View
            android:id="@+id/colorDot1"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/button_pill_accent"
            android:backgroundTint="@color/nest_primary"
            android:layout_marginEnd="12dp" />

        <View
            android:id="@+id/colorDot2"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/button_pill_accent"
            android:backgroundTint="@color/nest_accent_coral"
            android:layout_marginEnd="12dp" />

        <View
            android:id="@+id/colorDot3"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/button_pill_accent"
            android:backgroundTint="@color/nest_accent_mint"
            android:layout_marginEnd="12dp" />

        <View
            android:id="@+id/colorDot4"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/button_pill_accent"
            android:backgroundTint="@color/nest_accent_amber"
            android:layout_marginEnd="12dp" />

        <View
            android:id="@+id/colorDot5"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/button_pill_accent"
            android:backgroundTint="@color/nest_accent_cyan" />
    </LinearLayout>

    <!-- Widget Resize & Span Section -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="WIDGET SIZE &amp; SPAN"
        android:textColor="@color/nest_primary"
        android:textSize="12sp"
        android:fontFamily="sans-serif-bold"
        android:letterSpacing="0.08" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnSpanCol1"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:text="Normal Width (1x)"
            android:textSize="11sp"
            android:layout_marginEnd="6dp" />

        <Button
            android:id="@+id/btnSpanCol2"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:text="Wide Width (2x)"
            android:textSize="11sp"
            android:layout_marginEnd="6dp" />

        <Button
            android:id="@+id/btnSpanRow2"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:text="Tall Height (2x)"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Option to completely remove widget -->
    <Button
        android:id="@+id/btnRemoveWidget"
        style="@style/Widget.Material3.Button.TonalButton"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="12dp"
        android:text="🗑️ Remove Widget (Leave Slot Blank)"
        android:textColor="@color/night_red_accent"
        android:textSize="13sp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#2E3340"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="16dp" />

    <!-- Bottom Actions: Change Widget Type & Done -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- Option at the very bottom to change widget -->
        <Button
            android:id="@+id/btnChangeWidgetType"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="wrap_content"
            android:layout_height="46dp"
            android:text="🔄 Change Widget Type..."
            android:textColor="@color/nest_primary"
            android:textSize="13sp" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <Button
            android:id="@+id/btnDoneWidgetConfig"
            style="@style/Widget.Material3.Button"
            android:layout_width="wrap_content"
            android:layout_height="46dp"
            android:text="Done"
            android:backgroundTint="@color/nest_primary_container"
            android:textColor="@color/nest_on_primary_container"
            android:paddingStart="24dp"
            android:paddingEnd="24dp" />
    </LinearLayout>
</LinearLayout>

