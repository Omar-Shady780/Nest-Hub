<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_card_bg"
    android:padding="18dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_calendar" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="Calendar Schedule"
            android:textColor="@color/nest_primary"
            android:textSize="14sp"
            android:fontFamily="sans-serif-medium" />

        <Button
            android:id="@+id/btnOpenCalendar"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:text="+ Event"
            android:textSize="11sp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp" />
    </LinearLayout>

    <!-- Schedule Event 1 -->
    <LinearLayout
        android:id="@+id/calendarEvent1Container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center_vertical"
        android:layout_marginTop="8dp">

        <TextView
            android:id="@+id/calendarEvent1Title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="No events scheduled today"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/calendarEvent1Time"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tap to open calendar"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Schedule Event 2 -->
    <LinearLayout
        android:id="@+id/calendarEvent2Container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/calendarEvent2Title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Team Review"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/calendarEvent2Time"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="2:00 PM – 3:00 PM"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
