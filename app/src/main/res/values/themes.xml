<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.NestHubStandby" parent="Theme.Material3.Dark.NoActionBar">
        <item name="android:statusBarColor">@color/transparent</item>
        <item name="android:navigationBarColor">@color/transparent</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:windowTranslucentStatus">false</item>
        <item name="android:windowTranslucentNavigation">false</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="colorPrimary">@color/nest_primary</item>
        <item name="colorSecondary">@color/nest_accent_cyan</item>
        <item name="android:colorBackground">@color/nest_dark_bg</item>
    </style>

    <style name="Animation.NestHub.DialogZoom" parent="@android:style/Animation.Dialog">
        <item name="android:windowEnterAnimation">@anim/dialog_zoom_enter</item>
        <item name="android:windowExitAnimation">@anim/dialog_zoom_exit</item>
    </style>
</resources>

