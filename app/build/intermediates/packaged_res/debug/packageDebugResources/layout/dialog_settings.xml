<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#191B22"
    android:padding="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nest Hub Settings"
            android:textColor="@color/white"
            android:textSize="24sp"
            android:fontFamily="sans-serif-bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Customize your bedside smart display &amp; widgets"
            android:textColor="@color/text_secondary"
            android:textSize="14sp" />

        <!-- Grid Layout Section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="WIDGET GRID LAYOUT"
            android:textColor="@color/nest_primary"
            android:textSize="12sp"
            android:fontFamily="sans-serif-bold"
            android:letterSpacing="0.08" />

        <RadioGroup
            android:id="@+id/radioGroupGrid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/radioGrid2x2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="2 × 2 Grid (4 Large Widgets)"
                android:textColor="@color/white"
                android:textSize="14sp" />

            <RadioButton
                android:id="@+id/radioGrid3x3"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="3 × 3 Grid (9 Compact Widgets)"
                android:textColor="@color/white"
                android:textSize="14sp" />
        </RadioGroup>

        <!-- Background & Themes Section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="BACKGROUND &amp; WALLPAPER"
            android:textColor="@color/nest_primary"
            android:textSize="12sp"
            android:fontFamily="sans-serif-bold"
            android:letterSpacing="0.08" />

        <!-- Quick Background Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnCopyDeviceWallpaper"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:text="Copy Device Wallpaper"
                android:textSize="12sp"
                android:layout_marginEnd="8dp" />

            <Button
                android:id="@+id/btnImportCustomBg"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:text="Import Photo..."
                android:textSize="12sp"
                android:layout_marginEnd="8dp" />

            <Button
                android:id="@+id/btnDynamicTheme"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:text="Dynamic Time/Weather"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- 10 Gradients Row -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="10 Gradient Presets"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:fontFamily="sans-serif-medium" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp">

            <LinearLayout
                android:id="@+id/gradientButtonsContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <!-- 10 Solid Colors Row -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="10 Solid Color Presets (OLED Pure Black &amp; Tones)"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:fontFamily="sans-serif-medium" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp">

            <LinearLayout
                android:id="@+id/solidButtonsContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <!-- Bedside Display Options -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="BEDSIDE &amp; DISPLAY OPTIONS"
            android:textColor="@color/nest_primary"
            android:textSize="12sp"
            android:fontFamily="sans-serif-bold"
            android:letterSpacing="0.08" />

        <CheckBox
            android:id="@+id/checkKeepScreenOn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Keep Screen On (Bedside Dock Mode)"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:checked="true" />

        <CheckBox
            android:id="@+id/checkRedFilter"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Bedtime Red Shift Filter (Protects Night Vision)"
            android:textColor="@color/white"
            android:textSize="14sp" />

        <CheckBox
            android:id="@+id/check24Hour"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Use 24-Hour Time Format"
            android:textColor="@color/white"
            android:textSize="14sp" />

        <!-- Actions -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="end"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnDoneSettings"
                style="@style/Widget.Material3.Button"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:text="Done"
                android:backgroundTint="@color/nest_primary_container"
                android:textColor="@color/nest_on_primary_container"
                android:paddingStart="24dp"
                android:paddingEnd="24dp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
