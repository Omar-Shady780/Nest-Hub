<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_card_bg"
    android:padding="16dp"
    android:gravity="center_vertical">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Now Playing"
        android:textColor="@color/nest_accent_coral"
        android:textSize="13sp"
        android:fontFamily="sans-serif-medium" />

    <TextView
        android:id="@+id/mediaTrackTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Weightless (Ambient 1)"
        android:textColor="@color/white"
        android:textSize="17sp"
        android:fontFamily="sans-serif-medium"
        android:maxLines="1"
        android:ellipsize="end" />

    <TextView
        android:id="@+id/mediaArtist"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Marconi Union"
        android:textColor="@color/text_secondary"
        android:textSize="13sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnMediaPrev"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="⏮"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btnMediaPlayPause"
            style="@style/Widget.Material3.Button"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:text="▶ / ⏸"
            android:textSize="13sp"
            android:backgroundTint="@color/nest_primary_container"
            android:textColor="@color/nest_on_primary_container" />

        <Button
            android:id="@+id/btnMediaNext"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="⏭"
            android:textSize="14sp" />
    </LinearLayout>
</LinearLayout>
