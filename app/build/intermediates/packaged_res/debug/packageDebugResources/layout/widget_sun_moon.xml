<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="@drawable/widget_card_bg"
    android:padding="16dp"
    android:gravity="center_vertical">

    <com.google.ambient.nesthub.views.MoonPhaseView
        android:id="@+id/moonPhaseCanvas"
        android:layout_width="72dp"
        android:layout_height="72dp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="14dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/moonPhaseTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Waxing Gibbous"
            android:textColor="@color/white"
            android:textSize="17sp"
            android:fontFamily="sans-serif-medium" />

        <TextView
            android:id="@+id/sunTimesText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Sunrise: 6:48 AM • Sunset: 5:58 PM"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/goldenHourText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Golden Hour: 5:15 PM"
            android:textColor="@color/nest_accent_amber"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
